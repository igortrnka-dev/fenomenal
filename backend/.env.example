SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key
SUPABASE_ANON_KEY=anon_key
# SHA-256 hashe admin secret keys, oddelené čiarkou (node -e "console.log(require('crypto').createHash('sha256').update('KĽÚČ').digest('hex'))")
ADMIN_KEY_HASHES=
# Náhodný reťazec na podpis admin session (aspoň 32 znakov)
ADMIN_SESSION_SECRET=
# Povolené originy (frontend, admin), oddelené čiarkou
CORS_ORIGINS=https://fenomenal.vercel.app,https://fenomenal-admin.vercel.app
PORT=3000
# Stripe (test: sk_test_… / pk_test_…), webhook secret z Stripe → Developers → Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Adresa webu (návrat zo Stripe po platbe)
SITE_URL=http://localhost:5173
# Ďakovný e-mail po platbe cez Resend (resend.com); bez kľúča sa e-mail neposiela
RESEND_API_KEY=
MAIL_FROM=FENOMENAL <objednavky@fenomenal.wtf>
# Kam pôjdu odpovede zákazníkov (nepovinné)
MAIL_REPLY_TO=
